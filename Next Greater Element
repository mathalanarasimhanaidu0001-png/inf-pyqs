solution 

#include<iostream>
#include<vector>
#include<stack>
using namespace std;

class Solution{
    public:
    vector<int> next_greater_number_righ(vector<int>& nums){
        stack<int> st;
        vector<int> ans(nums.size(),-1);
        
        
        for(int i=(int)nums.size()-1; i>=0;i--){
            while(!st.empty() &&  st.top()<=nums[i] ){
                st.pop();
            }
            
            if(!st.empty()){
                ans[i]=st.top();
            }
            st.push(nums[i]);
            
        }
        return ans;
    }
};

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n;
    cin>>n;
    
    vector<int> nums(n);
    for(int i= 0 ; i< n;i++){
        cin>>nums[i];
    }
    
    Solution obj;
    vector<int> result = obj.next_greater_number_righ(nums);
    for(int i=0;i<n;i++){
        cout<<result[i]<<"   ";
    }
}
