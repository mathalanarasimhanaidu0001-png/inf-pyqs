Problem 5 — Minimum Base with Identical Digits
Tier: Easy (Q1) | Marks: 20 | Topic: Number Theory / Base Conversion

Problem
Given a positive integer 
N
≥
3
, find the smallest base 
b
≥
2
 such that the representation of 
N
 in base 
b
 consists of all identical digits with at least two digits (i.e., 
2
≤
b
≤
N
−
1
).

Sample Input:

N = 13
Sample Output:

3
Explanation: 
13
 in base 
3
 is 111 (three identical digits '1').

Constraints: 
3
≤
N
≤
10
12
.


TCS STYLE -- BRUTE FORCE APPROACH 

#include<iostream>
using namespace std;

class solution{
    public:
    
    long long  small_base(long long N){
        for( long long  b =2; b < N ;b++){
            long long  num = N; // declaring temporary variable num
            
            long long  digit = num%b; // to get  reference digit
            num = num/b;  // to get  the  quotient
            
            bool same = true ; //  assume that all digits are identical 
            
            while(num > 0 ){
                
                long long  current  = num % b ;
                
                if(current != digit ){ // to check other number with reference digit 
                    same=false ;
                    break;
                }
                  num = num/b;
                
            }
            if(same){ // return first valid base 
                return  b;
            }
            
            
            
        }
        
        
                return -1;
            
    }
};

int main()
{
    long long  N ;
    cin>>N;
    
    solution obj;
    cout<<obj.small_base(N);
}
